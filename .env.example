# Copy to .env (which is gitignored) and fill in. NEVER commit real values.
# In production these are set as Netlify environment variables (OM §10).

# --- Server-side only (Netlify Functions). Secrets — never exposed to the browser. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAKE_WEBHOOK_URL=

HUBSPOT_ACCESS_TOKEN=

# Shopify (headless storefront): Shopify owns products + checkout; the portal owns the experience.
# Storefront API token (read products) — server-side only. e.g. SHOPIFY_STORE_DOMAIN=acme.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# --- Frontend (VITE_*). Build-time, PUBLIC — never put secrets here. ---
# Cloudinary cloud name for delivery URLs (public; defaults to the demo cloud in dev).
VITE_CLOUDINARY_CLOUD=
# Optional unsigned upload preset to enable in-portal uploads.
VITE_CLOUDINARY_UPLOAD_PRESET=
# Backend switches: "mock" (default) or the live backend to use the Netlify functions.
VITE_MEDIA_BACKEND=mock      # mock | cloudinary
VITE_CRM_BACKEND=mock        # mock | make
VITE_STORE_BACKEND=mock      # mock | shopify (products via Storefront API; needs SHOPIFY_* above)
VITE_CAMPAIGNS_BACKEND=mock  # mock | make (deferred — no live backend yet)
VITE_PRICING_BACKEND=mock    # mock | (real function deferred)
# Point local dev at a deployed Netlify Identity instance (optional).
VITE_GOTRUE_URL=
# Set to "false" to preview the real login screen locally (default bypasses auth in dev).
VITE_DEV_BYPASS_AUTH=
