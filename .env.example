# Copy to .env (which is gitignored) and fill in. NEVER commit real values.
# In production these are set as Netlify environment variables (OM §10).

# --- Server-side only (Netlify Functions). Secrets — never exposed to the browser. ---
# Pilot passcode gate, three tiers (ADMIN_DASHBOARDS_SPEC §2; used when VITE_AUTH_MODE=passcode):
# client passcode → "client" role; admin passcode → "client-admin" (Manage features; per-tenant
# var wins over the generic one, e.g. PORTAL_ADMIN_PASSCODE_MONTITRENTINI); house passcode →
# "admin" (CST staff). Use three DIFFERENT values.
PORTAL_PASSCODE=
PORTAL_ADMIN_PASSCODE=
# PORTAL_ADMIN_PASSCODE_MONTITRENTINI=
PORTAL_HOUSE_PASSCODE=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Make scenario webhooks (server-side).
# MAKE_WEBHOOK_URL was the CRM leg — DELETED 2026-07-16, dead in code (zero refs in src/ or netlify/).
# CRM now reads HubSpot directly; see HUBSPOT_TOKEN below. Left here only so nobody re-adds it thinking
# it was an oversight. Campaigns still use Make and are unaffected.
MAKE_CAMPAIGNS_WEBHOOK_URL=

# HubSpot private-app token (server-side only). The name must be exactly HUBSPOT_TOKEN — that is
# what crm-hubspot.js / crm-summary.js / crm-push.js read via process.env. Scopes required by
# crm-summary.js: crm.objects.{contacts,companies,deals}.read.
HUBSPOT_TOKEN=

# Sentry (Netlify Functions half). Server-side error capture + a slow-response signal for the
# 25 functions in netlify/functions/ — see netlify/functions/_sentry.js. Env-gated: unset =
# every function behaves exactly as before, zero added latency. Same DSN project as
# VITE_SENTRY_DSN below, just the server key (Sentry gives you one DSN per project, used both
# places — no separate "server key" to generate).
SENTRY_DSN=

# Inventory live-sync (no app rebuild). Shared secret gating inventory-publish.js — the weekly
# sync (scripts/publish-inventory.mjs) must send the SAME value in the x-publish-secret header.
# Generate a long random string. Set in Netlify env; never commit the real value.
INVENTORY_PUBLISH_SECRET=

# Shopify (headless storefront): Shopify owns products + checkout; the portal owns the experience.
# Storefront token reads products; the Admin token (read_orders) reads web orders. Server-side only.
# e.g. SHOPIFY_STORE_DOMAIN=acme.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=

# --- Frontend (VITE_*). Build-time, PUBLIC — never put secrets here. ---
# Cloudinary cloud name for delivery URLs (public; defaults to the demo cloud in dev).
VITE_CLOUDINARY_CLOUD=
# Optional unsigned upload preset to enable in-portal uploads.
VITE_CLOUDINARY_UPLOAD_PRESET=
# Backend switches: "mock" (default) or the live backend to use the Netlify functions.
VITE_MEDIA_BACKEND=mock      # mock | cloudinary
VITE_CRM_BACKEND=mock        # mock | make
VITE_STORE_BACKEND=mock      # mock | shopify (products via Storefront API; needs SHOPIFY_* above)
VITE_CAMPAIGNS_BACKEND=mock  # mock | make (deferred — no live backend yet)
VITE_PRICING_BACKEND=mock    # mock (bundled snapshot) | function (live inventory via /.netlify/functions/inventory, no rebuild)
# Auth mode: "identity" (default, per-user Netlify Identity) or "passcode" (pilot shared-passcode
# gate). In passcode mode set PORTAL_PASSCODE (server) above; VITE_PORTAL_PASSCODE is the DEV-only
# local passcode for `npm run dev` (no functions server), default "monti".
VITE_AUTH_MODE=identity
VITE_PORTAL_PASSCODE=
# DEV-only local passcodes for the other tiers (defaults: "monti-admin", "house").
VITE_PORTAL_ADMIN_PASSCODE=
VITE_HOUSE_PASSCODE=
# Point local dev at a deployed Netlify Identity instance (optional).
VITE_GOTRUE_URL=
# Set to "false" to preview the real login screen locally (default bypasses auth in dev).
VITE_DEV_BYPASS_AUTH=

# Sentry (browser half). Error boundary + Core Web Vitals — see src/lib/monitoring.js. Env-gated:
# unset = the Sentry SDK is never even downloaded (dynamic import), zero bundle cost. Get this
# from sentry.io after creating a free project (React platform) — Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
