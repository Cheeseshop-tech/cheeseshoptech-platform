# Secrets — never commit
.env
.env.*
!.env.example
scripts/.inventory-publish.json

# Dependencies
node_modules/

# Build output
dist/
build/
.netlify/
vite.config.js.timestamp-*.mjs

# OS / editor
.DS_Store
*.log
.vscode/
.idea/

# MS Office temp-lock files
~$*

# Scratch files staged for manual deletion (device_bash can't rm on the mounted folder — see
# sandbox-git-lock-trap memory note) and one-off test harnesses that shouldn't ship
_to_delete/
_tmp_e2e_test*.mjs

# Blender render frames — intermediate output, reproducible from the .blend (112 PNGs ≈ 103MB).
# The rendered mp4 IS committed; the frame stack is not.
design/asiago-wheel/chalk_hero_render/frame_*.png
