{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cheeseshoptech.com/schemas/client.schema.json",
  "title": "CheeseShop TECH client (tenant) config",
  "description": "Per-client white-label config. Missing optional values fall back to the CheeseShop TECH house defaults (see docs/DESIGN_SYSTEM.md B2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subdomain",
    "brand"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique tenant id, lowercase kebab."
    },
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique subdomain under cheeseshoptech.com (wildcard routing)."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "colors"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "string",
          "description": "Logo URL. Falls back to the house wordmark if omitted."
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary"
          ],
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Brand primary hex. Must pass the WCAG AA contrast guardrail (B3)."
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Optional. Falls back to house accent #5F6B2E."
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string",
              "enum": [
                "Inter",
                "Fraunces",
                "Playfair Display",
                "Lora",
                "Source Sans 3",
                "Work Sans",
                "Libre Franklin",
                "Merriweather",
                "JetBrains Mono"
              ],
              "description": "From the font allowlist. Falls back to house Fraunces."
            },
            "body": {
              "type": "string",
              "enum": [
                "Inter",
                "Fraunces",
                "Playfair Display",
                "Lora",
                "Source Sans 3",
                "Work Sans",
                "Libre Franklin",
                "Merriweather",
                "JetBrains Mono"
              ],
              "description": "From the font allowlist. Falls back to house Inter."
            }
          }
        },
        "radius": {
          "type": "string",
          "enum": [
            "none",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Named radius step. Falls back to md."
        }
      }
    },
    "cloudinaryFolder": {
      "type": "string",
      "description": "Defaults to clients/<id>."
    },
    "cloudinaryLegacyFolders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra Cloudinary folders predating cloudinaryFolder (e.g. Monti's monti/<itemcode> packshots). Media Hub lists them too; SKU is derived from the filename server-side. Assets are NOT moved — delivery URLs stay valid."
    },
    "crm": {
      "type": "string",
      "enum": [
        "hubspot",
        "none"
      ],
      "default": "none"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "catalog",
          "orders",
          "crm",
          "media",
          "campaigns"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "description": "Landing-page (home hub) content: masthead + footer. The stat row is computed from the tenant's canonical data unless an explicit `stats` array is given.",
      "properties": {
        "eyebrow": {
          "type": "string",
          "description": "Small italic motto, top-right of the masthead."
        },
        "title": {
          "type": "string",
          "description": "Masthead display title (e.g. 'Operations Portal')."
        },
        "tagline": {
          "type": "string"
        },
        "footer": {
          "type": "string",
          "description": "Italic tagline in the footer."
        },
        "footerNote": {
          "type": "string"
        },
        "stats": {
          "type": "array",
          "description": "Optional explicit stat tiles. Omit to compute from data.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "accent": {
                "type": "string",
                "enum": [
                  "brand",
                  "accent",
                  "info",
                  "warning",
                  "success",
                  "error",
                  "fg"
                ]
              }
            }
          }
        }
      }
    },
    "presentations": {
      "type": "array",
      "description": "Buyer-facing slide decks (the Presentations tool). Slides are image URLs — local /presentations/<id>/… or Cloudinary.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "slides"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "eyebrow": {
            "type": "string",
            "description": "Small label above the deck title (e.g. 'Trade program · 2026')."
          },
          "description": {
            "type": "string"
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Ordered slide image URLs."
          }
        }
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "description": "The client's existing tools, surfaced as launch tiles on the Tools page.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "description": "lucide-react icon name (e.g. shopping-bag)"
          },
          "type": {
            "type": "string",
            "enum": [
              "external",
              "internal"
            ]
          },
          "url": {
            "type": "string",
            "description": "Required for type=external (opens in a new tab)."
          },
          "route": {
            "type": "string",
            "description": "Internal nav key for type=internal (e.g. media)."
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "coming-soon"
            ],
            "default": "live"
          },
          "tag": {
            "type": "string",
            "description": "Optional status eyebrow shown on the home-hub tool card (e.g. 'Quoting · priority #1')."
          },
          "featured": {
            "type": "boolean",
            "description": "Promote to its own top-level nav tab with a full page.",
            "default": false
          },
          "embed": {
            "type": "boolean",
            "description": "If featured + external, embed the tool in an iframe (only for framing-friendly sites).",
            "default": false
          },
          "admin": {
            "type": "boolean",
            "description": "If true, the featured page adds a Live/Admin toggle with a store back-office (admin/client only).",
            "default": false
          },
          "allowed": {
            "type": "array",
            "description": "Roles that may see this tool's launch card (home hub) and, if featured, its nav tab. Omit for the default (admin + client, i.e. open to every signed-in portal user). 2026-07-06.",
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "client-admin",
                "client",
                "pr",
                "influencer",
                "creator"
              ]
            }
          }
        }
      },
      "default": []
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where field bookings land (Booth to Meeting). Omit for tenants with no booking calendar.",
      "properties": {
        "provider": { "type": "string", "enum": ["google"] },
        "address": { "type": "string", "description": "The calendar the rep books into; also the invite ORGANIZER." },
        "defaultDurationMinutes": { "type": "integer", "minimum": 5, "default": 45 }
      },
      "required": ["provider", "address"]
    },
    "deals": {
      "type": "array",
      "description": "Offers a rep can put on the table (Booth to Meeting). Ships in the bundle so every tablet has them offline. Expired deals never reach a buyer recap.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "description": "Stable id stored on a capture." },
          "label": { "type": "string", "description": "Short name the rep taps, e.g. 'Show special'." },
          "detail": { "type": "string", "description": "The actual terms, as the buyer should read them." },
          "appliesTo": {
            "type": "array",
            "description": "Item numbers this deal covers. Omit for a blanket offer.",
            "items": { "type": "string" }
          },
          "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Last day the offer is valid (YYYY-MM-DD)." }
        }
      }
    },
    "contentQuota": {
      "type": "integer",
      "minimum": 1,
      "description": "Content Library storage cap for this tenant (CONTENT_ORCHESTRATION_SPEC §9). Omit to use DEFAULT_QUOTA."
    }
  }
}
