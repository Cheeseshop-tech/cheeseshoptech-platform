{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cheeseshoptech.com/schemas/client.schema.json",
  "title": "CheeseShop TECH client (tenant) config",
  "description": "Per-client white-label config. Missing optional values fall back to the CheeseShop TECH house defaults (see docs/DESIGN_SYSTEM.md B2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subdomain", "brand"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique tenant id, lowercase kebab."
    },
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique subdomain under cheeseshoptech.com (wildcard routing)."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "colors"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "logo": {
          "type": "string",
          "description": "Logo URL. Falls back to the house wordmark if omitted."
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Brand primary hex. Must pass the WCAG AA contrast guardrail (B3)."
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Optional. Falls back to house accent #5F6B2E."
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string",
              "enum": ["Inter", "Fraunces", "Playfair Display", "Lora", "Source Sans 3", "Work Sans", "Libre Franklin", "Merriweather", "JetBrains Mono"],
              "description": "From the font allowlist. Falls back to house Fraunces."
            },
            "body": {
              "type": "string",
              "enum": ["Inter", "Fraunces", "Playfair Display", "Lora", "Source Sans 3", "Work Sans", "Libre Franklin", "Merriweather", "JetBrains Mono"],
              "description": "From the font allowlist. Falls back to house Inter."
            }
          }
        },
        "radius": {
          "type": "string",
          "enum": ["none", "sm", "md", "lg", "xl"],
          "description": "Named radius step. Falls back to md."
        }
      }
    },
    "cloudinaryFolder": {
      "type": "string",
      "description": "Defaults to clients/<id>."
    },
    "crm": {
      "type": "string",
      "enum": ["hubspot", "none"],
      "default": "none"
    },
    "modules": {
      "type": "array",
      "items": { "type": "string", "enum": ["catalog", "orders", "crm", "media", "campaigns"] },
      "uniqueItems": true,
      "default": []
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "description": "Landing-page (home hub) content: masthead + footer. The stat row is computed from the tenant's canonical data unless an explicit `stats` array is given.",
      "properties": {
        "eyebrow": { "type": "string", "description": "Small italic motto, top-right of the masthead." },
        "title": { "type": "string", "description": "Masthead display title (e.g. 'Operations Portal')." },
        "tagline": { "type": "string" },
        "footer": { "type": "string", "description": "Italic tagline in the footer." },
        "footerNote": { "type": "string" },
        "stats": {
          "type": "array",
          "description": "Optional explicit stat tiles. Omit to compute from data.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": ["string", "number"] },
              "label": { "type": "string" },
              "accent": { "type": "string", "enum": ["brand", "accent", "info", "warning", "success", "error", "fg"] }
            }
          }
        }
      }
    },
    "presentations": {
      "type": "array",
      "description": "Buyer-facing slide decks (the Presentations tool). Slides are image URLs — local /presentations/<id>/… or Cloudinary.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "slides"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "eyebrow": { "type": "string", "description": "Small label above the deck title (e.g. 'Trade program · 2026')." },
          "description": { "type": "string" },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Ordered slide image URLs."
          }
        }
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "description": "The client's existing tools, surfaced as launch tiles on the Tools page.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "icon": { "type": "string", "description": "lucide-react icon name (e.g. shopping-bag)" },
          "type": { "type": "string", "enum": ["external", "internal"] },
          "url": { "type": "string", "description": "Required for type=external (opens in a new tab)." },
          "route": { "type": "string", "description": "Internal nav key for type=internal (e.g. media)." },
          "status": { "type": "string", "enum": ["live", "coming-soon"], "default": "live" },
          "tag": { "type": "string", "description": "Optional status eyebrow shown on the home-hub tool card (e.g. 'Quoting · priority #1')." },
          "featured": { "type": "boolean", "description": "Promote to its own top-level nav tab with a full page.", "default": false },
          "embed": { "type": "boolean", "description": "If featured + external, embed the tool in an iframe (only for framing-friendly sites).", "default": false },
          "admin": { "type": "boolean", "description": "If true, the featured page adds a Live/Admin toggle with a store back-office (admin/client only).", "default": false }
        }
      },
      "default": []
    }
  }
}
