{
  "name": "cheeseshoptech-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Multi-tenant white-label client portal platform for specialty & perishable food brands. Platform core = CheeseShop TECH (owned IP); clients are tenants.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:clients": "node scripts/validate-clients.mjs",
    "sync:images": "node scripts/sync-images.mjs",
    "prewarm": "node scripts/prewarm-cloudinary.mjs",
    "media:refresh": "node scripts/sync-images.mjs && node scripts/prewarm-cloudinary.mjs",
    "inventory:promote": "node scripts/sync-inventory.mjs --promote",
    "inventory:check": "node scripts/sync-inventory.mjs --check",
    "inventory:publish": "node scripts/publish-inventory.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gotrue-js": "^1.0.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
